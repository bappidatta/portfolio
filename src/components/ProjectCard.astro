---
interface Props {
  index?: number;
  title: string;
  description: string;
  tags?: string[];
  demoUrl?: string;
  repoUrl?: string;
}

const { index, title, description, tags = [], demoUrl, repoUrl } = Astro.props;
const slug = title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
---

<article class="card interactive">
  <div class="head">
    {index !== undefined && <span class="index mono">{String(index).padStart(2, '0')}</span>}
    <h3>{title}</h3>
    <span class="arrow" aria-hidden="true">→</span>
  </div>
  <p class="desc muted">{description}</p>
  <div class="foot">
    <div class="tags">
      {tags.slice(0, 5).map((t) => <span class="tag">{t}</span>)}
    </div>
    <div class="links mono">
      {demoUrl && <a href={demoUrl} target="_blank" rel="noopener">demo ↗</a>}
      {repoUrl && <a href={repoUrl} target="_blank" rel="noopener">source ↗</a>}
    </div>
  </div>
</article>

<style>
  article {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    height: 100%;
  }
  .head {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }
  .index {
    color: var(--accent);
    font-size: 0.75rem;
  }
  h3 {
    margin: 0;
    font-size: 1.1rem;
    flex: 1;
  }
  .arrow {
    color: var(--text-faint);
    transition: transform var(--dur) var(--ease), color var(--dur) ease;
  }
  article:hover .arrow {
    color: var(--accent);
    transform: translateX(4px);
  }
  .desc {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.6;
    flex: 1;
  }
  .foot {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: auto;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .links {
    display: flex;
    gap: 1.25rem;
    font-size: 0.75rem;
  }
</style>
