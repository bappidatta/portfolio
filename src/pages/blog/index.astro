---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<BaseLayout title="Writing" description="Technical writing on engineering, architecture, and tooling.">
  <header class="page-head reveal">
    <p class="eyebrow">Writing</p>
    <h1>Notes on engineering</h1>
    <p class="muted">
      Essays on architecture, performance, and tooling — written from practice, not theory.
      <a href="/rss.xml">RSS ↗</a>
    </p>
  </header>

  <ul class="list reveal">
    {
      posts.map((post) => (
        <li class="card interactive">
          <div class="meta mono">
            <time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
            <span class="tags">{post.data.tags.join(' · ')}</span>
          </div>
          <a class="title" href={`/blog/${post.id}/`}>{post.data.title}</a>
          <p class="muted desc">{post.data.description}</p>
        </li>
      ))
    }
  </ul>
</BaseLayout>

<style>
  .page-head {
    padding: 2.5rem 0 2rem;
  }
  .page-head h1 {
    font-size: 2.4rem;
    margin: 0 0 0.75rem;
  }
  .page-head .muted {
    max-width: 52ch;
    margin: 0;
    font-size: 1.05rem;
  }
  .list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .list li {
    padding: 1.4rem 1.6rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .meta {
    display: flex;
    gap: 1rem;
    font-size: 0.72rem;
    color: var(--text-faint);
    flex-wrap: wrap;
  }
  .meta .tags { color: var(--accent); }
  .title {
    font-size: 1.2rem;
    font-weight: 650;
    color: var(--text);
  }
  .title:hover { color: var(--accent); }
  .desc {
    margin: 0;
    font-size: 0.9rem;
    max-width: 64ch;
  }
</style>
